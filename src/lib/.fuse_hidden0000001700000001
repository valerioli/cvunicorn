/** Shared intake schema — drives the wizard UI, draft storage, and the AI
 *  generation prompt. One source of truth for "what can a user tell us". */

export type UploadedFile = {
  id: string;
  name: string;
  url: string; // blob URL or /api/upload?id=…
  size: number;
  type: string;
};

export type FieldType = "text" | "textarea" | "url" | "date";

export type FieldDef = {
  key: string;
  label: string;
  type: FieldType;
  placeholder?: string;
  required?: boolean;
};

export type ModuleDef = {
  id: ModuleId;
  icon: string;
  title: string;
  blurb: string; // why adding this helps
  entryNoun: string; // "project", "award"…
  fields: FieldDef[];
  allowFiles?: boolean;
  fileHint?: string;
  example?: string; // helpful prompt shown in the step
};

export type ModuleId =
  | "photos"
  | "projects"
  | "portfolio"
  | "articles"
  | "social"
  | "press"
  | "testimonials"
  | "talks"
  | "awards"
  | "caseStudies"
  | "videos"
  | "research"
  | "launches"
  | "other";

