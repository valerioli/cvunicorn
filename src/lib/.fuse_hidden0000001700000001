export type Entry = {
  id: string;
  values: Record<string, string>;
  files: UploadedFile[];
};

export type Essentials = {
  fullName: string;
  headline: string; // "CMO at AInfinity"
  profession: string; // slug or free text
  email: string;
  bio: string;
  location: string;
  photo?: UploadedFile | null;
  cv?: UploadedFile | null;
  cvText?: string; // extracted or pasted
};

export type IntakeData = {
  draftId: string;
  essentials: Essentials;
  selected: ModuleId[];
  entries: Partial<Record<ModuleId, Entry[]>>;
  updatedAt: number;
};

export function emptyIntake(): IntakeData {
  return {
    draftId:
      typeof crypto !== "undefined" && "randomUUID" in crypto
        ? crypto.randomUUID()
        : `d_${Date.now()}_${Math.random().toString(36).slice(2)}`,
    essentials: {
      fullName: "",
      headline: "",
      profession: "",
      email: "",
      bio: "",
      location: "",
      photo: null,
      cv: null,
      cvText: "",
    },
    selected: [],
    entries: {},
    updatedAt: Date.now(),
  };
}

export function getModule(id: ModuleId): ModuleDef {
  return modules.find((m) => m.id === id)!;
}

/** Richness score 0–100: powers the "more content = better site" meter. */
export function richnessScore(d: IntakeData): number {
  let score = 0;
  const e = d.essentials;
  if (e.fullName) score += 6;
  if (e.headline) score += 6;
  if (e.bio.length > 40) score += 8;
  if (e.photo) score += 8;
  if (e.cv || e.cvText.length > 100) score += 16;
  for (const id of d.selected) {
    const entries = d.entries[id] ?? [];
    const filled = entries.filter(
      (en) =>
        Object.values(en.values).some((v) => v.trim().length > 0) ||
        en.files.length > 0,
    ).length;
    if (filled > 0) score += Math.min(4 + filled * 2, 10);
  }
  return Math.min(100, score);
}

export function richnessLabel(score: number): { label: string; desc: string } {
  if (score >= 75)
    return {
      label: "Unicorn",
      desc: "Multi-page site with galleries, dedicated sections, and a magazine-grade layout — like our showcase sites.",
    };
  if (score >= 50)
    return {
      label: "Impressive",
      desc: "A rich single-page site with several distinct sections and strong visual moments.",
    };
  if (score >= 25)
    return {
      label: "Solid",
      desc: "A clean, professional site. Add photos, projects, or press to unlock more sections.",
    };
  return {
    label: "Starter",
    desc: "Enough for a simple site. Every module you add makes it visibly better.",
  };
}
