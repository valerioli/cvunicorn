# ——— Site ———
# Public URL of the deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://cvunicorn.com

# ——— AI generation (required for website generation) ———
# Default provider is OpenAI. Production needs an OpenAI Platform API key.
OPENAI_API_KEY=
# Optional: force a provider ("openai" or "anthropic") and override models.
# GENERATION_PROVIDER=openai
# OPENAI_GENERATION_MODEL=gpt-5.1
# ANTHROPIC_API_KEY=
# ANTHROPIC_GENERATION_MODEL=claude-sonnet-4-5

# ——— Payments ———
# Choose ONE provider:
#   "dev"    = simulated checkout for local testing (default, no account)
#   "stripe" = card payments via Stripe Checkout  ← recommended
#   "infini" = crypto (USDT/USDC) via Infini hosted checkout
PAYMENT_PROVIDER=dev

# --- Stripe (cards) ---
# dashboard.stripe.com → Developers → API keys (test keys need no documents).
# Test card: 4242 4242 4242 4242, any future expiry, any CVC.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create (Developers → Webhooks); starts "whsec_":
STRIPE_WEBHOOK_SECRET=

# --- Infini (crypto) ---
# From business.infini.money → Developer → Create API key:
INFINI_API_KEY=
INFINI_SECRET_KEY=
# "sandbox" while testing (test card 4000 0000 0000 0085), "production" to go live:
INFINI_ENV=sandbox
# Optional separate webhook secret (defaults to INFINI_SECRET_KEY):
INFINI_WEBHOOK_SECRET=

# Secret for signing access/receipt links. Generate with:
#   openssl rand -base64 32
ACCESS_TOKEN_SECRET=

# ——— Storage (recommended for production) ———
# Without these, drafts/orders/sites use in-memory storage (lost on restart).
# Vercel dashboard → Storage/Marketplace → Upstash Redis (free tier works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# File uploads: Vercel dashboard → Storage → Blob.
# Without it, uploads use an in-memory dev fallback.
BLOB_READ_WRITE_TOKEN=
